{% comment %}
  Shared Variables - Station Name Mapping
  
  Maps station codes to display names for dynamic title bar.
  Station code is available via: trainDepartures.stationCode
{% endcomment %}

{% assign stationCode = trainDepartures.stationCode %}

{% comment %} Map station code to display name {% endcomment %}
{% case stationCode %}
  {% comment %} Lakeshore East {% endcomment %}
  {% when 'UN' %}{% assign stationName = 'Union Station' %}
  {% when 'EX' %}{% assign stationName = 'Exhibition GO' %}
  {% when 'DA' %}{% assign stationName = 'Danforth GO' %}
  {% when 'SC' %}{% assign stationName = 'Scarborough GO' %}
  {% when 'EG' %}{% assign stationName = 'Eglinton GO' %}
  {% when 'GU' %}{% assign stationName = 'Guildwood GO' %}
  {% when 'RO' %}{% assign stationName = 'Rouge Hill GO' %}
  {% when 'PIN' %}{% assign stationName = 'Pickering GO' %}
  {% when 'AJ' %}{% assign stationName = 'Ajax GO' %}
  {% when 'WH' %}{% assign stationName = 'Whitby GO' %}
  {% when 'OS' %}{% assign stationName = 'Oshawa GO' %}
  
  {% comment %} Lakeshore West {% endcomment %}
  {% when 'MI' %}{% assign stationName = 'Mimico GO' %}
  {% when 'LO' %}{% assign stationName = 'Long Branch GO' %}
  {% when 'PO' %}{% assign stationName = 'Port Credit GO' %}
  {% when 'CL' %}{% assign stationName = 'Clarkson GO' %}
