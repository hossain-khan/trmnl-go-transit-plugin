{% comment %}
  GO Transit Union Station Departures - Half Vertical Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez|KI,Kitchener,08:48,4,Bloor-Mount Dennis-Weston,Proceed / Avancez|LE,Lakeshore East,08:50,11 & 12,Danforth-Scarborough-Eglinton,Wait / Attendez|BR,Barrie,08:52,13,Downsview Park-Rutherford-Maple,Wait / Attendez|ST,Stouffville,09:00,3,Kennedy-Agincourt-Milliken,Proceed / Avancez|LW,Lakeshore West,09:04,5 & 6,Express To-Exhibition-Port Credit,Proceed / Avancez|LW,Lakeshore West,09:17,10,Exhibition-Mimico-Long Branch,Wait / Attendez|LE,Lakeshore East,09:20,11,Danforth-Scarborough-Eglinton,Wait / Attendez" | split: "|" %}

<div class="layout layout--col p--3 mb--0">
  
  <!-- Header -->
  <div class="mb--2">
    <span class="title title--small">Departures</span>
  </div>
  
  <!-- Vertical Departure List -->
  <div class="flex flex--col gap--xsmall">
    {% for departure_data in sample_departures %}
      {% assign departure = departure_data | split: "," %}
      <div class="outline p--2">
        
        <!-- Line & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--1">
          <span class="label label--small label--inverted">{{ departure[0] }}</span>
          <span class="title title--small">{{ departure[1] }}</span>
        </div>
        
        <!-- Route -->
        <div class="mb--1">
          <span class="description text--gray-35" data-clamp="1">Union Station - {{ departure[4] }}</span>
        </div>
        
        <!-- Time, Platform, Status -->
        <div class="flex flex--row gap--small flex--center-y">
          <div>
            <span class="label label--small">Time</span>
            <div class="value value--small">{{ departure[2] }}</div>
          </div>
          <div>
            <span class="label label--small">Platform</span>
            <div class="value value--xsmall">{{ departure[3] }}</div>
          </div>
          <div class="flex--1 text--right">
            {% if departure[5] contains "Proceed" %}
              <span class="label label--small label--inverted">Proceed</span>
            {% else %}
              <span class="label label--small label--outline">Wait</span>
            {% endif %}
          </div>
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
</div>
