{% comment %}
  GO Transit Union Station Departures - Half Vertical Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez,#98002e|BR,Barrie,08:52,-,Downsview Park-Rutherford-Maple,Wait / Attendez,#003767|ST,Stouffville,09:00,3,Kennedy-Agincourt-Milliken,Proceed / Avancez,#794500" | split: "|" %}

<div class="layout layout--col p--3 mb--0">
  
  <!-- Vertical Departure List -->
  <div class="flex flex--col gap--xsmall">
    {% for departure_data in sample_departures %}
      {% assign departure = departure_data | split: "," %}
      <div class="outline p--2 stretch-x">
        
        <!-- Line & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--1 stretch-x">
          <span class="label label--small lg:label--base label--inverted" style="background-color: {{ departure[6] }};">{{ departure[0] }}</span>
          <span class="title title--small md:title--medium lg:title--large">{{ departure[1] }}</span>
        </div>
        
        <!-- Time, Platform, Status (Union Station only) -->
        <!-- Platform information is only available from Union Station -->
        <!-- Union Station is the major inter-city transportation hub of the Greater Toronto and Hamilton Area (GTHA). -->
        <div class="flex flex--row gap--small flex--center-y stretch-x">
          <div style="min-width: 70px;">
            <span class="label label--small lg:label--base">Time</span>
            <div class="value value--medium md:value--large lg:value--xlarge">{{ departure[2] }}</div>
          </div>
          <div style="min-width: 60px;">
            <span class="label label--small lg:label--base">Platform</span>
            <div class="value value--small lg:value--medium">
              {% if departure[3] == "-" %}
                <span class="description lg:description--large">TBD</span>
              {% else %}
                {{ departure[3] }}
              {% endif %}
            </div>
          </div>
          <div class="flex--1 text--right">
            {% if departure[5] contains "Proceed" %}
              <span class="label label--small lg:label--base label--inverted">Go</span>
            {% else %}
              <span class="label label--small lg:label--base label--outline">Wait</span>
            {% endif %}
          </div>
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
  <span class="instance">Departures</span>
</div>
