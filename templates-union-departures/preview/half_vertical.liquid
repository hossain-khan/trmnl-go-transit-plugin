{% comment %}
  GO Transit Union Station Departures - Half Vertical Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez,#98002e|KI,Kitchener,08:48,4,Bloor-Mount Dennis-Weston,Proceed / Avancez,#00853e|LE,Lakeshore East,08:50,-,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00|BR,Barrie,08:52,13,Downsview Park-Rutherford-Maple,Wait / Attendez,#003767|ST,Stouffville,09:00,3,Kennedy-Agincourt-Milliken,Proceed / Avancez,#794500|LW,Lakeshore West,09:04,-,Express To-Exhibition-Port Credit,Proceed / Avancez,#98002e|LW,Lakeshore West,09:17,10,Exhibition-Mimico-Long Branch,Wait / Attendez,#98002e|LE,Lakeshore East,09:20,11,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00" | split: "|" %}

<div class="layout layout--col p--3 mb--0">
  
  <!-- Header -->
  <div class="mb--2">
    <span class="title title--small">Departures</span>
  </div>
  
  <!-- Vertical Departure List -->
  <div class="flex flex--col gap--xsmall">
    {% for departure_data in sample_departures %}
      {% assign departure = departure_data | split: "," %}
      <div class="outline p--2 stretch-x">
        
        <!-- Line & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--1 stretch-x">
          <span class="label label--small label--inverted" style="background-color: {{ departure[6] }};">{{ departure[0] }}</span>
          <span class="title title--small md:title--medium">{{ departure[1] }}</span>
        </div>
        
        <!-- Route -->
        <div class="mb--1">
          <span class="description text--gray-35" data-clamp="1">Union Station - {{ departure[4] }}</span>
        </div>
        
        <!-- Time, Platform, Status -->
        <div class="flex flex--row gap--small flex--center-y stretch-x">
          <div style="min-width: 70px;">
            <span class="label label--small">Time</span>
            <div class="value value--medium md:value--large">{{ departure[2] }}</div>
          </div>
          <div style="min-width: 60px;">
            <span class="label label--small">Platform</span>
            <div class="value value--small">
              {% if departure[3] == "-" %}
                <span class="description">TBD</span>
              {% else %}
                {{ departure[3] }}
              {% endif %}
            </div>
          </div>
          <div class="flex--1 text--right">
            {% if departure[5] contains "Proceed" %}
              <span class="label label--small label--inverted">Go</span>
            {% else %}
              <span class="label label--small label--outline">Wait</span>
            {% endif %}
          </div>
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
</div>
