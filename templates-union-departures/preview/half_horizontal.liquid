{% comment %}
  GO Transit Union Station Departures - Half Horizontal Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez,#98002e|KI,Kitchener,08:48,4,Bloor-Mount Dennis-Weston,Proceed / Avancez,#00853e|LE,Lakeshore East,08:50,11 & 12,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00" | split: "|" %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Three-Column Departure Grid -->
  <div class="columns gap--small">
    {% for departure_data in sample_departures %}
      {% assign departure = departure_data | split: "," %}
      <div class="column">
        <div class="outline p--2">
          
          <!-- Line Badge & Service -->
          <div class="flex flex--row gap--xsmall flex--center-y mb--1">
            <span class="label label--small label--inverted" style="background-color: {{ departure[6] }};">{{ departure[0] }}</span>
            <span class="title title--small">{{ departure[1] }}</span>
          </div>
          
          <!-- Route Info -->
          <div class="mb--1 text--center">
            <span class="description" data-clamp="1">{{ departure[0] }} → Union Station</span>
          </div>
          
          <!-- Time (Large) -->
          <div class="mb--1">
            <span class="value value--large md:value--xlarge">{{ departure[2] }}</span>
          </div>
          
          <!-- Platform & Status -->
          <div class="flex flex--row gap--small flex--center-y">
            <div>
              <span class="label label--small">{{ departure[3] }}</span>
            </div>
            <div>
              {% if departure[5] contains "Proceed" %}
                <span class="label label--small label--inverted">Go</span>
              {% else %}
                <span class="label label--small label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
  <span class="instance">Departures</span>
</div>
