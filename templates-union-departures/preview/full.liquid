{% comment %}
  GO Transit Union Station Departures - Full Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez,#98002e|KI,Kitchener,08:48,4,Bloor-Mount Dennis-Weston,Proceed / Avancez,#00853e|LE,Lakeshore East,08:50,11 & 12,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00|BR,Barrie,08:52,13,Downsview Park-Rutherford-Maple,Wait / Attendez,#003767|ST,Stouffville,09:00,3,Kennedy-Agincourt-Milliken,Proceed / Avancez,#794500|LW,Lakeshore West,09:04,5 & 6,Express To-Exhibition-Port Credit,Proceed / Avancez,#98002e|LW,Lakeshore West,09:17,10,Exhibition-Mimico-Long Branch,Wait / Attendez,#98002e|LE,Lakeshore East,09:20,11,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00" | split: "|" %}

<style type="text/css">
  .departure-row {
    border-bottom: 1px solid #e0e0e0;
    padding: 12px 0;
  }
  
  .departure-row:last-child {
    border-bottom: none;
  }
  
  .line-indicator {
    width: 6px;
    height: 100%;
    border-radius: 2px;
  }
  
  .line-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: bold;
    color: white;
    min-width: 36px;
    text-align: center;
  }
  
  .status-icon {
    display: inline-block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #e0e0e0;
    margin-right: 4px;
    vertical-align: middle;
  }
</style>

<div class="layout layout--col p--3 mb--0">
  
  <!-- Header -->
  <div class="mb--2">
    <span class="title title--large">Departures</span>
  </div>
  
  <!-- Departure List -->
  <div class="flex flex--col gap--small">
    {% for departure_data in sample_departures %}
      {% assign departure = departure_data | split: "," %}
      <div class="departure-row">
        <div class="flex flex--row gap--small flex--center-y">
          
          <!-- Line Indicator Bar -->
          <div class="line-indicator" style="background-color: {{ departure[6] }};"></div>
          
          <!-- Line Badge & Route Info -->
          <div class="flex--1">
            <div class="flex flex--row gap--xsmall flex--center-y mb--1">
              <span class="line-badge" style="background-color: {{ departure[6] }};">{{ departure[0] }}</span>
              <span class="title title--small">{{ departure[1] }}</span>
            </div>
            <span class="description text--gray-35">Union Station - {{ departure[4] }}</span>
          </div>
          
          <!-- Scheduled Time -->
          <div class="text--center" style="min-width: 80px;">
            <span class="label label--small">Scheduled:</span>
            <span class="value value--medium">{{ departure[2] }}</span>
          </div>
          
          <!-- Platform -->
          <div class="text--center" style="min-width: 70px;">
            <span class="label label--small">Platform:</span>
            <span class="value value--small">{{ departure[3] }}</span>
          </div>
          
          <!-- Status -->
          <div class="text--center" style="min-width: 120px;">
            <span class="label label--small">Status:</span>
            <div class="flex flex--row flex--center-x gap--xsmall">
              <span class="status-icon"></span>
              <span class="description">{{ departure[5] }}</span>
            </div>
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
</div>
