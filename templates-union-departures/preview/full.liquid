{% comment %}
  GO Transit Union Station Departures - Full Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez,#98002e|KI,Kitchener,08:48,4,Bloor-Mount Dennis-Weston,Proceed / Avancez,#00853e|LE,Lakeshore East,08:50,11 & 12,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00|BR,Barrie,08:52,13,Downsview Park-Rutherford-Maple,Wait / Attendez,#003767|ST,Stouffville,09:00,-,Kennedy-Agincourt-Milliken,Proceed / Avancez,#794500|LW,Lakeshore West,09:04,5 & 6,Express To-Exhibition-Port Credit,Proceed / Avancez,#98002e|LW,Lakeshore West,09:17,-,Exhibition-Mimico-Long Branch,Wait / Attendez,#98002e|LE,Lakeshore East,09:20,11,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00" | split: "|" %}

<div class="layout layout--col p--3 mb--0">
  
  <!-- Header -->
  <div class="mb--2">
    <span class="title title--large">Departures</span>
  </div>
  
  <!-- Departure List -->
  <div class="flex flex--col gap--small">
    {% for departure_data in sample_departures %}
      {% assign departure = departure_data | split: "," %}
      <div class="outline mb--small p--2">
        <div class="flex flex--row gap--small flex--center-y" style="width: 100%;">
          
          <!-- Line Badge & Route Info -->
          <div class="flex--1" style="min-width: 0;">
            <div class="flex flex--row gap--xsmall flex--center-y mb--1">
              <span class="label label--small label--inverted" style="background-color: {{ departure[6] }};">{{ departure[0] }}</span>
              <span class="title title--small md:title--medium">{{ departure[1] }}</span>
            </div>
            <span class="description text--gray-35" data-clamp="1">Union Station - {{ departure[4] }}</span>
          </div>
          
          <!-- Scheduled Time -->
          <div class="text--center" style="min-width: 100px;">
            <span class="label label--small">Scheduled</span>
            <div class="value value--large md:value--xlarge">{{ departure[2] }}</div>
          </div>
          
          <!-- Platform -->
          <div class="text--center" style="min-width: 80px;">
            <span class="label label--small">Platform</span>
            <div class="value value--small md:value--medium">
              {% if departure[3] == "-" %}
                <span class="description">TBD</span>
              {% else %}
                {{ departure[3] }}
              {% endif %}
            </div>
          </div>
          
          <!-- Status -->
          <div class="text--center" style="min-width: 80px;">
            <span class="label label--small">Status</span>
            <div class="description">
              {% if departure[5] contains "Proceed" %}
                <span class="label label--small label--inverted">Proceed</span>
              {% else %}
                <span class="label label--small label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
</div>
