{% comment %}
  GO Transit Union Station Departures - Full Layout Preview
  Static sample data for design testing
{% endcomment %}

{% assign sample_departures = "LW,Lakeshore West,08:47,7 & 8,Exhibition-Mimico-Long Branch,Proceed / Avancez,#98002e|KI,Kitchener,08:48,4,Bloor-Mount Dennis-Weston,Proceed / Avancez,#00853e|LE,Lakeshore East,08:50,11 & 12,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00|BR,Barrie,08:52,13,Downsview Park-Rutherford-Maple,Wait / Attendez,#003767|ST,Stouffville,09:00,-,Kennedy-Agincourt-Milliken,Proceed / Avancez,#794500|LW,Lakeshore West,09:04,5 & 6,Express To-Exhibition-Port Credit,Proceed / Avancez,#98002e|LW,Lakeshore West,09:17,-,Exhibition-Mimico-Long Branch,Wait / Attendez,#98002e|LE,Lakeshore East,09:20,11,Danforth-Scarborough-Eglinton,Wait / Attendez,#ff0d00" | split: "|" %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Two-Column Departure Grid (3 rows × 2 columns) -->
  <div class="grid grid--cols-2 gap--small">
    {% for departure_data in sample_departures limit: 6 %}
      {% assign departure = departure_data | split: "," %}
      <div class="outline p--2">
        
        <!-- Line Badge & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--1">
          <span class="label label--small lg:label--base label--inverted" style="background-color: {{ departure[6] }};">{{ departure[0] }}</span>
          <span class="title title--small lg:title--base">{{ departure[1] }}</span>
        </div>
        
        <!-- Time, Route, Platform & Status (single row) -->
        <div class="flex flex--row lg:flex--col gap--small flex--center-y">
          <div class="text--center">
            <span class="value value--large md:value--xlarge lg:value--xxlarge">{{ departure[2] }}</span>
          </div>
          <div class="flex--1 flex flex--col gap--xsmall">
            <span class="description lg:description--large">{{ departure[4] }}</span>
            <div class="flex flex--row gap--xsmall">
              <span class="label label--small lg:label--base">Platform</span>
              {% if departure[3] == "-" %}
                <span class="label label--small lg:label--base">TBD</span>
              {% else %}
                <span class="label label--small lg:label--base">{{ departure[3] }}</span>
              {% endif %}
              {% if departure[5] contains "Proceed" %}
                <span class="label label--small lg:label--base label--inverted">Go</span>
              {% else %}
                <span class="label label--small lg:label--base label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
  <span class="instance">Departures</span>
</div>
