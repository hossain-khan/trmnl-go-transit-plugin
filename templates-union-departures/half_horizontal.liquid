{% comment %}
  GO Transit Union Station Departures - Half Horizontal Layout
  
  Use Case: Half-size horizontal display (abundant horizontal space, minimal vertical)
  
  Features:
  - Compact departure list (4-5 departures)
  - Essential info only: line, service, time, status
  - Optimized for wide, short displays
{% endcomment %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Header -->
  <div class="mb--1">
    <span class="title title--small">Departures</span>
  </div>
  
  <!-- Compact Departure List -->
  <div class="flex flex--col gap--xsmall">
    {% for departure in trainDepartures.items limit: 5 %}
      <div class="outline p--1">
        <div class="flex flex--row gap--small flex--center-y" style="width: 100%;">
          
          <!-- Line Badge & Service -->
          <div class="flex flex--row gap--xsmall flex--center-y" style="min-width: 0;">
            <span class="label label--small label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
            <span class="description md:title--small">{{ departure.service }}</span>
          </div>
          
          <!-- Route Info -->
          <div class="flex--1" style="min-width: 0;">
            <span class="description text--gray-35" data-clamp="1">{{ departure.stopsDisplay }}</span>
          </div>
          
          <!-- Time -->
          <div style="min-width: 60px;">
            <span class="value value--medium md:value--large">{{ departure.scheduledTime }}</span>
          </div>
          
          <!-- Platform -->
          <div style="min-width: 45px; text-align: center;">
            {% if departure.platform == "-" %}
              <span class="label label--small">-</span>
            {% else %}
              <span class="label label--small">{{ departure.platform }}</span>
            {% endif %}
          </div>
          
          <!-- Status -->
          <div style="min-width: 65px;">
            {% if departure.info contains "Proceed" %}
              <span class="label label--small label--inverted">Go</span>
            {% else %}
              <span class="label label--small label--outline">Wait</span>
            {% endif %}
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
</div>
