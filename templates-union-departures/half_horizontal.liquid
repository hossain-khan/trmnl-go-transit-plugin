{% comment %}
  GO Transit Departures - Half Horizontal Layout
  
  Use Case: Half-size horizontal display (abundant horizontal space, minimal vertical)
  
  Features:
  - Three-column layout (1 row × 3 columns)
  - Vertical stacking: service name, route info, time, platform/status
  - Optimized for wide, short displays
{% endcomment %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Three-Column Departure Grid -->
  <div class="columns gap--small">
    {% for departure in trainDepartures.items limit: 3 %}
      <div class="column">
        <div class="outline p--2">
          
          <!-- Line Badge & Service -->
          <div class="flex flex--row gap--xsmall flex--center-y mb--1">
            <span class="label label--small lg:label--base label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
            <span class="title title--small lg:title--base">{{ departure.service }}</span>
          </div>
          
          <!-- Route Info -->
          <div class="mb--1 text--center">
            <span class="description lg:description--large" data-clamp="1">{{ departure.stopsDisplay }}</span>
          </div>
          
          <!-- Time (Large) -->
          <div class="mb--1">
            <span class="value value--large md:value--xlarge lg:value--xxlarge" data-value-fit="true">{{ departure.scheduledTime }}</span>
          </div>
          
          <!-- Platform information is only available from Union Station -->
          <!-- Union Station is the major inter-city transportation hub of the Greater Toronto and Hamilton Area (GTHA). -->
          {% if stationCode == 'UN' %}
          <div class="flex flex--row gap--small flex--center-y">
            <div>
              <span class="label label--small lg:label--base">Platform</span>
              {% if departure.platform == "-" or departure.platform == blank or departure.platform == "" %}
                <span class="label label--small lg:label--base">TBD</span>
              {% else %}
                <span class="label label--small lg:label--base">{{ departure.platform }}</span>
              {% endif %}
            </div>
            <div>
              {% if departure.info contains "Proceed" %}
                <span class="label label--small lg:label--base label--inverted">Go</span>
              {% else %}
                <span class="label label--small lg:label--base label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
          {% endif %}
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <img class="image" src="{{ icon_go_transit }}" style="height: 18px;">
  <span class="title">{{ stationName }}</span>
  <span class="instance">Departures</span>
</div>
