{% comment %}
  GO Transit Union Station Departures - Half Horizontal Layout
  
  Use Case: Half-size horizontal display (abundant horizontal space, minimal vertical)
  
  Features:
  - Three-column layout (1 row × 3 columns)
  - Vertical stacking: service name, route info, time, platform/status
  - Optimized for wide, short displays
{% endcomment %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Three-Column Departure Grid -->
  <div class="columns gap--small">
    {% for departure in trainDepartures.items limit: 3 %}
      <div class="column">
        <div class="outline p--2">
          
          <!-- Line Badge & Service -->
          <div class="flex flex--row gap--xsmall flex--center-y mb--1">
            <span class="label label--small label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
            <span class="title title--small">{{ departure.service }}</span>
          </div>
          
          <!-- Route Info -->
          <div class="mb--1 text--center">
            <span class="description" data-clamp="1">{{ departure.lineCode }} → Union Station</span>
          </div>
          
          <!-- Time (Large) -->
          <div class="mb--1">
            <span class="value value--large md:value--xlarge">{{ departure.scheduledTime }}</span>
          </div>
          
          <!-- Platform & Status -->
          <div class="flex flex--row gap--small flex--center-y">
            <div>
              {% if departure.platform == "-" %}
                <span class="label label--small">-</span>
              {% else %}
                <span class="label label--small">{{ departure.platform }}</span>
              {% endif %}
            </div>
            <div>
              {% if departure.info contains "Proceed" %}
                <span class="label label--small label--inverted">Go</span>
              {% else %}
                <span class="label label--small label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
  <span class="instance">Departures</span>
</div>
