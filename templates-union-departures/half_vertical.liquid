{% comment %}
  GO Transit Departures - Half Vertical Layout
  
  Use Case: Half-size vertical display (abundant vertical space, limited horizontal)
  
  Features:
  - Compact vertical list (3 items max)
  - Stacked layout for narrow width
  - Full information per departure
{% endcomment %}

<div class="layout layout--col p--3 mb--0">
  
  <!-- Vertical Departure List -->
  <div class="flex flex--col gap--xsmall">
    {% for departure in trainDepartures.items limit: 3 %}
      <div class="outline p--2 stretch-x">
        
        <!-- Line & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--1 stretch-x">
          <span class="label label--small label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
          <span class="title title--small md:title--medium">{{ departure.service }}</span>
        </div>
        

        <!-- Time, Platform, Status -->
        <div class="flex flex--row gap--small flex--center-y stretch-x">
          <div style="min-width: 70px;">
            <!-- Route Info -->
            <span class="label label--small">{{ departure.stopsDisplay }}</span>
            <div class="value value--medium md:value--large">{{ departure.scheduledTime }}</div>
          </div>
          {% if stationCode == 'UN' %}
          <div style="min-width: 60px;">
            <span class="label label--small">Platform</span>
            <div class="value value--small">
              {% if departure.platform == "-" or departure.platform == blank or departure.platform == "" %}
                <span class="description">TBD</span>
              {% else %}
                {{ departure.platform }}
              {% endif %}
            </div>
          </div>
          <div class="flex--1 text--right">
            {% if departure.info contains "Proceed" %}
              <span class="label label--small label--inverted">Go</span>
            {% else %}
              <span class="label label--small label--outline">Wait</span>
            {% endif %}
          </div>
          {% endif %}
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <img class="image" src="{{ icon_go_transit }}" style="height: 18px;">
  <span class="title">{{ stationName }}</span>
  <span class="instance">Departures</span>
</div>
