{% comment %}
  GO Transit Union Station Departures - Full Layout
  
  Use Case: Full-screen departure board display
  
  Features:
  - List of upcoming departures with color-coded line badges
  - Service name and route information
  - Scheduled departure times
  - Platform information
  - Status indicators (Proceed/Wait)
  
  Data Structure Expected:
  {
    "stationCode": "UN",
    "trainDepartures": {
      "items": [
        {
          "lineCode": "LW",
          "service": "Lakeshore West",
          "scheduledTime": "08:47",
          "platform": "7 & 8",
          "stopsDisplay": "Exhibition-Mimico-Long Branch",
          "info": "Proceed / Avancez",
          "lineColour": "#98002e"
        }
      ]
    }
  }
{% endcomment %}

<div class="layout layout--col p--3 mb--0">
  
  <!-- Header -->
  <div class="mb--2">
    <span class="title title--large">Departures</span>
  </div>
  
  <!-- Departure List -->
  <div class="flex flex--col gap--small">
    {% for departure in trainDepartures.items limit: 8 %}
      <div class="outline mb--small p--2">
        <div class="flex flex--row gap--small flex--center-y" style="width: 100%;">
          
          <!-- Line Badge & Route Info -->
          <div class="flex--1" style="min-width: 0;">
            <div class="flex flex--row gap--xsmall flex--center-y mb--1">
              <span class="label label--small label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
              <span class="title title--small md:title--medium">{{ departure.service }}</span>
            </div>
            <span class="description text--gray-35" data-clamp="1">Union Station - {{ departure.stopsDisplay }}</span>
          </div>
          
          <!-- Scheduled Time -->
          <div class="text--center" style="min-width: 100px;">
            <span class="label label--small">Scheduled</span>
            <div class="value value--large md:value--xlarge">{{ departure.scheduledTime }}</div>
          </div>
          
          <!-- Platform -->
          <div class="text--center" style="min-width: 80px;">
            <span class="label label--small">Platform</span>
            <div class="value value--small md:value--medium">
              {% if departure.platform == "-" %}
                <span class="description">TBD</span>
              {% else %}
                {{ departure.platform }}
              {% endif %}
            </div>
          </div>
          
          <!-- Status -->
          <div class="text--center" style="min-width: 80px;">
            <span class="label label--small">Status</span>
            <div class="description">
              {% if departure.info contains "Proceed" %}
                <span class="label label--small label--inverted">Proceed</span>
              {% else %}
                <span class="label label--small label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
</div>
