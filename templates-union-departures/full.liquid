{% comment %}
  GO Transit Union Station Departures - Full Layout
  
  Use Case: Full-screen departure board display
  
  Features:
  - List of upcoming departures with color-coded line badges
  - Service name and route information
  - Scheduled departure times
  - Platform information
  - Status indicators (Proceed/Wait)
  
  Data Structure Expected:
  {
    "stationCode": "UN",
    "trainDepartures": {
      "items": [
        {
          "lineCode": "LW",
          "service": "Lakeshore West",
          "scheduledTime": "08:47",
          "platform": "7 & 8",
          "stopsDisplay": "Exhibition-Mimico-Long Branch",
          "info": "Proceed / Avancez",
          "lineColour": "#98002e"
        }
      ]
    }
  }
{% endcomment %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Two-Column Departure Grid (3 rows × 2 columns) -->
  <div class="grid grid--cols-2 gap--small">
    {% for departure in trainDepartures.items limit: 6 %}
      <div class="outline p--2">
        
        <!-- Line Badge & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--1">
          <span class="label label--small label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
          <span class="title title--small">{{ departure.service }}</span>
        </div>
        
        <!-- Time, Route, Platform & Status (single row) -->
        <div class="flex flex--row gap--small flex--center-y">
          <div class="text--center">
            <span class="value value--large md:value--xlarge">{{ departure.scheduledTime }}</span>
          </div>
          <div class="flex--1 flex flex--col gap--xsmall">
            <span class="description">{{ departure.stopsDisplay }}</span>
            <div class="flex flex--row gap--xsmall">
              <span class="label label--small">Platform</span>
              {% if departure.platform == "-" %}
                <span class="label label--small">TBD</span>
              {% else %}
                <span class="label label--small">{{ departure.platform }}</span>
              {% endif %}
              {% if departure.info contains "Proceed" %}
                <span class="label label--small label--inverted">Go</span>
              {% else %}
                <span class="label label--small label--outline">Wait</span>
              {% endif %}
            </div>
          </div>
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
  <span class="instance">Departures</span>
</div>
