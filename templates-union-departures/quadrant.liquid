{% comment %}
  GO Transit Union Station Departures - Quadrant Layout
  
  Use Case: Quarter-size display (most compact)
  
  Features:
  - Two-column grid (3 rows × 2 columns, 6 items max)
  - Essential info only: line, service, time, status
  - Most compact presentation
{% endcomment %}

<div class="layout layout--col p--2 mb--0">
  
  <!-- Two-Column Departure Grid -->
  <div class="grid grid--cols-2 gap--xsmall">
    {% for departure in trainDepartures.items limit: 6 %}
      <div class="outline p--1 stretch-x">
        
        <!-- Line Badge & Service -->
        <div class="flex flex--row gap--xsmall flex--center-y mb--xsmall stretch-x">
          <span class="label label--small label--inverted" {% if departure.lineColour %}style="background-color: {{ departure.lineColour }};"{% endif %}>{{ departure.lineCode }}</span>
          <span class="description" style="flex: 1; min-width: 0;">{{ departure.service }}</span>
        </div>
        
        <!-- Time & Status -->
        <div class="flex flex--row gap--xsmall flex--center-y stretch-x">
          <span class="value value--small md:value--medium">{{ departure.scheduledTime }}</span>
          <span style="min-width: 35px;">
            {% if departure.platform == "-" %}
              <span class="label label--small">TBD</span>
            {% else %}
              <span class="label label--small">{{ departure.platform }}</span>
            {% endif %}
          </span>
          <div class="flex--1 text--right">
            {% if departure.info contains "Proceed" %}
              <span class="label label--small label--inverted">Go</span>
            {% else %}
              <span class="label label--small label--outline">Wait</span>
            {% endif %}
          </div>
        </div>
        
      </div>
    {% endfor %}
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Union Station</span>
  <span class="instance">Departures</span>
</div>
