{% comment %}
  GO Transit Dashboard - Quadrant Layout
  Adapted from Sound Transit Link Light Rail Dashboard
  
  Use Case: Quarter-size display (most compact)
  
  Features:
  - Two columns showing both directions
  - Only arriving/next times (no "later" - space constraint)
  - Most compact layout
  - Station name in title bar
{% endcomment %}

<div class="layout layout--row p--2 gap--xxlarge mb--0">
  <div class="flex flex--col flex--stretch-x flex--top gap--none stretch">
    
    <!-- Two-direction time table -->
    <div class="columns time-table">
      
      <!-- Direction 1 -->
      <div class="column gap--medium" data-overflow="true">
        <div>
          <div class="title title--small">{{ direction_1.origin }}</div>
        </div>
        
        <!-- Departing -->
        <div class="item item--emphasis-3">
          <div class="meta"></div>
          <div class="content text--black">
            <span class="label label--small label--inverted mb--1">departing</span>
            <span>
              <span class="value value--medium">{{ direction_1.arriving | split: " " | first }}</span>
              <span class="value value--xsmall">{{ direction_1.arriving | split: " " | last }}</span>
            </span>
          </div>
        </div>
        
        <!-- Next -->
        <div class="item item--emphasis-2">
          <div class="meta"></div>
          <div class="content text--gray-35">
            <span class="label label--small label--outline mb--1">next</span>
            <span>
              <span class="value value--medium">{{ direction_1.next | split: " " | first }}</span>
              <span class="value value--xsmall">{{ direction_1.next | split: " " | last }}</span>
            </span>
          </div>
        </div>
      </div>
      
      <!-- Direction 2 -->
      <div class="column gap--medium" data-overflow="true">
        <div>
          <div class="title title--small">{{ direction_2.origin }}</div>
        </div>
        
        <!-- Arriving -->
        <div class="item item--emphasis-3">
          <div class="meta"></div>
          <div class="content text--black">
            <span class="label label--small label--inverted mb--1">arriving</span>
            <span>
              <span class="value value--medium">{{ direction_2.arriving | split: " " | first }}</span>
              <span class="value value--xsmall">{{ direction_2.arriving | split: " " | last }}</span>
            </span>
          </div>
        </div>
        
        <!-- Next -->
        <div class="item item--emphasis-2">
          <div class="meta"></div>
          <div class="content text--gray-35">
            <span class="label label--small label--outline mb--1">next</span>
            <span>
              <span class="value value--medium">{{ direction_2.next | split: " " | first }}</span>
              <span class="value value--xsmall">{{ direction_2.next | split: " " | last }}</span>
            </span>
          </div>
        </div>
      </div>
      
    </div>
    
  </div>
</div>

<div class="title_bar m--0">
  <span class="title">{{ station }}</span>
</div>
