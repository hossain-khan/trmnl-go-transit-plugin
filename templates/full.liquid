{% comment %}
  GO Transit Dashboard - Full Layout
  Adapted from Sound Transit Link Light Rail Dashboard
  
  Use Case: Full-screen display (entire TRMNL screen)
  
  Features:
  - Two-direction schedule with arriving/next/later times
  - Service alerts at bottom
  - Station name in title bar
{% endcomment %}

<style type="text/css">
  .alerts-section {
    max-height: 25%;
  }
</style>

<div class="layout layout--col p--4 mb--0">
  
  <!-- Schedule Header -->
  <div class="mb--2">
    <span class="label label--small label--underline">Schedule</span>
  </div>
  
  <!-- Two-direction time table -->
  <div class="columns time-table mb--4">
    
    <!-- Direction 1 -->
    <div class="column gap--small">
      <div class="mb--1">
        <span class="title title--small" style="display: block;">{{ direction_1.label | split: "To " | last }}</span>
        <span class="description">{{ direction_1.label }}</span>
      </div>
      
      <!-- Arriving -->
      <div class="item item--emphasis-3">
        <div class="meta"></div>
        <div class="content">
          <span class="label label--small label--inverted mb--1">arriving</span>
          <span>
            <span class="value value--small">{{ direction_1.arriving | split: " " | first }}</span>
            <span class="value value--xxsmall">{{ direction_1.arriving | split: " " | last }}</span>
          </span>
          {% if direction_1.arriving_status != "On Time" %}
            <span class="label label--small label--outline text--gray-35">{{ direction_1.arriving_status }}</span>
          {% endif %}
        </div>
      </div>
      
      <!-- Next -->
      <div class="item item--emphasis-2">
        <div class="meta"></div>
        <div class="content text--gray-35">
          <span class="label label--small label--outline mb--1">next</span>
          <span>
            <span class="value value--small">{{ direction_1.next | split: " " | first }}</span>
            <span class="value value--xxsmall">{{ direction_1.next | split: " " | last }}</span>
          </span>
        </div>
      </div>
      
      <!-- Later -->
      <div class="item item--emphasis-1">
        <div class="meta"></div>
        <div class="content text--gray-50">
          <span class="label label--small mb--1">later</span>
          <span>
            <span class="value value--small">{{ direction_1.later | split: " " | first }}</span>
            <span class="value value--xxsmall">{{ direction_1.later | split: " " | last }}</span>
          </span>
        </div>
      </div>
    </div>
    
    <!-- Direction 2 -->
    <div class="column gap--small">
      <div class="mb--1">
        <span class="title title--small" style="display: block;">{{ direction_2.label | split: "To " | last }}</span>
        <span class="description">{{ direction_2.label }}</span>
      </div>
      
      <!-- Arriving -->
      <div class="item item--emphasis-3">
        <div class="meta"></div>
        <div class="content">
          <span class="label label--small label--inverted mb--1">arriving</span>
          <span>
            <span class="value value--small">{{ direction_2.arriving | split: " " | first }}</span>
            <span class="value value--xxsmall">{{ direction_2.arriving | split: " " | last }}</span>
          </span>
          {% if direction_2.arriving_status != "On Time" %}
            <span class="label label--small label--outline text--gray-35">{{ direction_2.arriving_status }}</span>
          {% endif %}
        </div>
      </div>
      
      <!-- Next -->
      <div class="item item--emphasis-2">
        <div class="meta"></div>
        <div class="content text--gray-35">
          <span class="label label--small label--outline mb--1">next</span>
          <span>
            <span class="value value--small">{{ direction_2.next | split: " " | first }}</span>
            <span class="value value--xxsmall">{{ direction_2.next | split: " " | last }}</span>
          </span>
          {% if direction_2.next_status != "On Time" %}
            <span class="label label--small text--gray-35">{{ direction_2.next_status }}</span>
          {% endif %}
        </div>
      </div>
      
      <!-- Later -->
      <div class="item item--emphasis-1">
        <div class="meta"></div>
        <div class="content text--gray-50">
          <span class="label label--small mb--1">later</span>
          <span>
            <span class="value value--small">{{ direction_2.later | split: " " | first }}</span>
            <span class="value value--xxsmall">{{ direction_2.later | split: " " | last }}</span>
          </span>
        </div>
      </div>
    </div>
    
  </div>
  
  <!-- Alerts Section -->
  {% if has_alerts %}
    <div class="mb--2">
      <span class="label label--small label--underline">Alerts</span>
    </div>
    <div class="alerts-section">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="description" data-clamp="2">{{ alerts }}</span>
          <span class="label label--small label--underline">active: {{ updated_at | date: "%D %l:%M %p" }}</span>
        </div>
      </div>
    </div>
  {% endif %}
  
</div>

<div class="title_bar m--0">
  <span class="title">{{ station }}</span>
</div>
