{% comment %}
  GO Transit Dashboard - Full Layout PREVIEW
  Static preview template with sample data (no API dependency)
  
  Sample Data: Lakeshore East Line - Oshawa GO Station
{% endcomment %}

<style type="text/css">
  .alerts-section {
    max-height: 25%;
  }
</style>

<div class="layout layout--col p--4 mb--0">
  
  <!-- Schedule Header -->
  <div class="mb--2">
    <span class="label label--small label--underline">Schedule</span>
  </div>
  
  <!-- Two-direction time table -->
  <div class="columns time-table mb--4">
    
    <!-- Direction 1 -->
    <div class="column gap--small">
      <div class="mb--1">
        <span class="title title--small" style="display: block;">Union Station</span>
        <span class="description">To Union Station</span>
      </div>
      
      <!-- Arriving -->
      <div class="item item--emphasis-3">
        <div class="meta"></div>
        <div class="content">
            <span class="label label--small label--inverted mb--1">departing</span>
          <span>
            <span class="value value--small">8:38</span>
            <span class="value value--xxsmall">PM</span>
          </span>
        </div>
      </div>
      
      <!-- Next -->
      <div class="item item--emphasis-2">
        <div class="meta"></div>
        <div class="content text--gray-35">
          <span class="label label--small label--outline mb--1">next</span>
          <span>
            <span class="value value--small">9:09</span>
            <span class="value value--xxsmall">PM</span>
          </span>
        </div>
      </div>
      
      <!-- Later -->
      <div class="item item--emphasis-1">
        <div class="meta"></div>
        <div class="content text--gray-50">
          <span class="label label--small mb--1">later</span>
          <span>
            <span class="value value--small">9:39</span>
            <span class="value value--xxsmall">PM</span>
          </span>
        </div>
      </div>
    </div>
    
    <!-- Direction 2 -->
    <div class="column gap--small">
      <div class="mb--1">
        <span class="title title--small" style="display: block;">Oshawa GO</span>
        <span class="description">To Oshawa GO</span>
      </div>
      
      <!-- Arriving -->
      <div class="item item--emphasis-3">
        <div class="meta"></div>
        <div class="content">
          <span class="label label--small label--inverted mb--1">departing</span>
          <span>
            <span class="value value--small">8:50</span>
            <span class="value value--xxsmall">PM</span>
          </span>
        </div>
      </div>
      
      <!-- Next -->
      <div class="item item--emphasis-2">
        <div class="meta"></div>
        <div class="content text--gray-35">
          <span class="label label--small label--outline mb--1">next</span>
          <span>
            <span class="value value--small">9:20</span>
            <span class="value value--xxsmall">PM</span>
          </span>
        </div>
      </div>
      
      <!-- Later -->
      <div class="item item--emphasis-1">
        <div class="meta"></div>
        <div class="content text--gray-50">
          <span class="label label--small mb--1">later</span>
          <span>
            <span class="value value--small">9:50</span>
            <span class="value value--xxsmall">PM</span>
          </span>
        </div>
      </div>
    </div>
    
  </div>
  
</div>

<div class="title_bar m--0">
  <span class="title">Oshawa GO</span>
</div>
